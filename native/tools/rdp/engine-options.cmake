# Keep the upstream SDL3 frontend, graphics/input/clipboard and platform audio.
# No guacd/server, external codecs, drive/smartcard/USB forwarding, or X11.
set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(WITH_SERVER OFF CACHE BOOL "" FORCE)
set(WITH_SAMPLE OFF CACHE BOOL "" FORCE)
set(WITH_MANPAGES OFF CACHE BOOL "" FORCE)
set(WITH_X11 OFF CACHE BOOL "" FORCE)
set(WITH_WAYLAND OFF CACHE BOOL "" FORCE)
set(WITH_CLIENT_WINDOWS OFF CACHE BOOL "" FORCE)
set(WITH_CLIENT_MAC OFF CACHE BOOL "" FORCE)
set(WITH_CLIENT_SDL ON CACHE BOOL "" FORCE)
set(WITH_CLIENT_SDL2 OFF CACHE BOOL "" FORCE)
set(WITH_CLIENT_SDL3 ON CACHE BOOL "" FORCE)
set(WITH_SDL_LINK_SHARED ON CACHE BOOL "" FORCE)
set(WITH_FFMPEG OFF CACHE BOOL "" FORCE)
set(WITH_SWSCALE OFF CACHE BOOL "" FORCE)
set(WITH_OPENH264 OFF CACHE BOOL "" FORCE)
set(WITH_CUPS OFF CACHE BOOL "" FORCE)
set(WITH_PCSC OFF CACHE BOOL "" FORCE)
set(WITH_PKCS11 OFF CACHE BOOL "" FORCE)
set(WITH_SMARTCARD_EMULATE OFF CACHE BOOL "" FORCE)
set(WITH_FUSE OFF CACHE BOOL "" FORCE)
set(WITH_URBDRC OFF CACHE BOOL "" FORCE)
set(CHANNEL_URBDRC OFF CACHE BOOL "" FORCE)
set(CHANNEL_SMARTCARD OFF CACHE BOOL "" FORCE)
set(CHANNEL_DRIVE OFF CACHE BOOL "" FORCE)
set(WITH_CJSON_REQUIRED ON CACHE BOOL "" FORCE)
set(VENDOR "EasyNode / FreeRDP project" CACHE STRING "" FORCE)
set(PROJECT_URL "https://github.com/chaos-zhu/easynode" CACHE STRING "" FORCE)
set(WITH_WINPR_TOOLS OFF CACHE BOOL "" FORCE)
set(CMAKE_EXPORT_NO_PACKAGE_REGISTRY ON CACHE BOOL "" FORCE)
